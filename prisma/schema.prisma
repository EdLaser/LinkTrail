// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    previewFeatures = ["postgresqlExtensions"]
}

datasource db {
    provider = "postgresql"
}

// Your own application's user (e.g., a Bikemap account holder using your service)
model AppUser {
    id        String   @id @default(uuid())
    email     String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    hammerheadAccount HammerheadAccount?
    syncedRoutes      SyncedRoute[]

    @@map("app_users")
}

// One Hammerhead OAuth connection per AppUser
model HammerheadAccount {
    id                 String   @id @default(uuid())
    appUserId          String   @unique
    hammerheadUserId   String   // Remote user ID from Hammerhead
    accessToken        String   // Encrypted AES-256-GCM
    refreshToken       String   // Encrypted AES-256-GCM
    scope              String   // Space-separated OAuth scopes granted
    expiresAt          DateTime // Token expiry time for refresh logic
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt

    appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

    @@map("hammerhead_accounts")
}

// Routes synced from Bikemap to Hammerhead
model SyncedRoute {
    id               String   @id @default(uuid())
    appUserId        String
    bikemapRouteId   String   // Identifier from Bikemap
    hammerheadRouteId String  // Route ID returned by Hammerhead after creation/update
    name             String
    description      String?
    distance         Float
    elevationGain    Float
    checksum         String   // SHA-256 of the GPX file content (detect changes)
    lastSyncedAt     DateTime @default(now())
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

    @@unique([appUserId, bikemapRouteId])
    @@map("synced_routes")
}
